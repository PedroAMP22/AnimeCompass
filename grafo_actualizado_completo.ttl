ns2:characterIn a owl:ObjectProperty ;
    rdfs:label "character In in"@en ;
    rdfs:comment "A relation between a character and the programme in which appears."@en ;
    rdfs:domain ns2:Character ;
    rdfs:range <http://purl.org/ontology/po/Programme> ;
    owl:propertyChainAxiom [ ] .

ns2:costarring a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "costarring"@en ;
    rdfs:comment "A relation between two main characters."@en ;
    rdfs:domain ns2:MainCharacter ;
    rdfs:range ns2:MainCharacter .

ns2:directedBy a owl:ObjectProperty ;
    rdfs:label "directed By da"@en ;
    rdfs:comment "A relation between a programme and its director."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range ns2:Director .

ns2:dubbedBy a owl:ObjectProperty ;
    rdfs:label "dubbed By"@en ;
    rdfs:comment "Relation between a character and the voice actor that dubs it."@en ;
    rdfs:domain ns2:Character ;
    rdfs:range ns2:VoiceActor ;
    owl:inverseOf ns2:voiceOf .

ns2:endingOf a owl:ObjectProperty ;
    rdfs:label "ending of"@en ;
    rdfs:comment "A relation between an ending theme and its programme."@en ;
    rdfs:domain ns2:Ending ;
    rdfs:range <http://purl.org/ontology/po/Programme> ;
    owl:inverseOf ns2:hasEnding .

ns2:englishTitle a owl:DatatypeProperty ;
    rdfs:label "englishTitle"@en ;
    rdfs:comment "The english title of the programme."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range xsd:string .

ns2:episodeTitle a owl:DatatypeProperty ;
    rdfs:label "episodio title"@en ;
    rdfs:comment "The title of an episode."@en ;
    rdfs:domain <http://purl.org/ontology/po/Episode> ;
    rdfs:range xsd:string .

ns2:firstAiring a owl:DatatypeProperty ;
    rdfs:label "first airing"@en ;
    rdfs:comment "The date of the first airing."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range xsd:dateTime .

ns2:followsEpisode a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "follows episode"@en ;
    rdfs:comment "A relation between an episode and the antecedent."@en ;
    rdfs:domain <http://purl.org/ontology/po/Episode> ;
    rdfs:range <http://purl.org/ontology/po/Episode> ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows> ;
    owl:inverseOf ns2:precedesEpisode .

ns2:hasEpisode a owl:ObjectProperty ;
    rdfs:label "has episodio"@en ;
    rdfs:comment "A relation between a series and the episodes that are part of it."@en ;
    rdfs:domain <http://purl.org/ontology/po/Series> ;
    rdfs:range <http://purl.org/ontology/po/Episode> ;
    rdfs:subPropertyOf ns3:hasItem ;
    owl:inverseOf ns2:isEpisodeOf .

ns2:hasOpening a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has opening"@en ;
    rdfs:comment "A relation between a programme and its opening theme."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range ns2:Opening ;
    owl:inverseOf ns2:openingOf .

ns2:mainOf a owl:ObjectProperty ;
    rdfs:label "main of"@en ;
    rdfs:comment "Relation between a character and the programme in which has a main role."@en ;
    rdfs:domain ns2:MainCharacter ;
    rdfs:range <http://purl.org/ontology/po/Programme> .

ns2:narrativeRoleIn a owl:ObjectProperty ;
    rdfs:label "narrative role in"@en ;
    rdfs:comment "Relation between a narrative role and the programme which is part of."@en ;
    rdfs:domain ns2:NarrativeRole ;
    rdfs:range <http://purl.org/ontology/po/Programme> ;
    rdfs:subPropertyOf ns2:roleIn .

ns2:produced a owl:ObjectProperty ;
    rdfs:label "produced"@en ;
    rdfs:comment "Relation between a studio and the programme that it produced."@en ;
    rdfs:domain ns2:Studio ;
    rdfs:range <http://purl.org/ontology/po/Programme> ;
    owl:inverseOf ns2:producedBy .

ns2:productionRoleIn a owl:ObjectProperty ;
    rdfs:label "production role in"@en ;
    rdfs:comment "Relation between a production role and the programme whose production has worked on."@en ;
    rdfs:domain ns2:ProductionRole ;
    rdfs:range <http://purl.org/ontology/po/Programme> ;
    rdfs:subPropertyOf ns2:roleIn .

ns2:runtime a owl:DatatypeProperty ;
    rdfs:label "runtime"@en ;
    rdfs:comment "The duration of the programme in minutes."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf owl:topDataProperty .

ns2:shortSeries a owl:DatatypeProperty ;
    rdfs:label "short series"@en ;
    rdfs:comment "Boolean value that is true if the series has less then 15 episodes."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range xsd:boolean .

ns2:voiceActorIn a owl:ObjectProperty ;
    rdfs:label "voice actor in"@en ;
    rdfs:comment "A relation between a real person and a programme for which performs the role of voice actor."@en ;
    rdfs:domain ns2:VoiceActor ;
    rdfs:range <http://purl.org/ontology/po/Programme> ;
    owl:propertyChainAxiom [ ] .

ns2:voiceRole a owl:ObjectProperty ;
    rdfs:label "voice Role"@en ;
    rdfs:comment "A relation between the role of Voice Actor and a Character."@en ;
    rdfs:domain ns2:VoiceActorRole ;
    rdfs:range ns2:Character .

ns2:workedFor a owl:ObjectProperty ;
    rdfs:label "worked for"@en ;
    rdfs:comment "Relation between a person and a production studio for which he/she woorked for in the making of a programme."@en ;
    rdfs:domain ns2:RealPerson ;
    rdfs:range ns2:Studio .


ns2:MainCharacter a owl:Class ;
    rdfs:label "Main Character"@en ;
    rdfs:comment "A character that has a main role."@en ;
    rdfs:subClassOf ns2:Character ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf [ ] ] .


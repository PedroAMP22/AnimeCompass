ns2:DirectorRole a owl:Class ;
    rdfs:label "Director Role"@en ;
    rdfs:comment "The role of who oversees the making of the work."@en ;
    rdfs:subClassOf ns2:ProductionRole .

ns2:Drama a owl:NamedIndividual ;
    rdfs:label "Drama"@en ;
    rdfs:comment "A genre of programme intended to be more serious than humorous in tone."@en .

ns2:Main a owl:Class ;
    rdfs:label ":Main"@en ;
    rdfs:comment "A main character"@en ;
    rdfs:subClassOf ns2:NarrativeRole ;
    owl:disjointWith ns2:Supporting,
        ns2:Villain .

ns2:Opening a owl:Class ;
    rdfs:label "Opening"@en ;
    rdfs:comment "The theme song at the start of a programme."@en ;
    rdfs:subClassOf ns2:ThemeSong .

ns2:Sakamichi_No_Apollon_support a ns2:Supporting,
        owl:NamedIndividual ;
    rdfs:label "SNA suppoert"@en ;
    ns2:narrativeRoleIn ns2:Sakamichi_No_Apollon ;
    rdfs:comment "A support role in Sakamichi No Apollon"@en .

ns2:SoundDirectorRole a owl:Class ;
    rdfs:label "Sound Director Role"@en ;
    rdfs:comment "The role of the head of the sound department and the person responsible for planning the audiography."@en ;
    rdfs:subClassOf ns2:ProductionRole .

ns2:Villain a owl:Class ;
    rdfs:label "Villain"@en ;
    rdfs:comment "A bad character"@en ;
    rdfs:subClassOf ns2:NarrativeRole .


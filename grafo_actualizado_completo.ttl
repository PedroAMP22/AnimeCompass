ns2:Ending a owl:Class ;
    rdfs:label "Ending"@en ;
    rdfs:comment "The theme song at the ending of a programme."@en ;
    rdfs:subClassOf ns2:ThemeSong ;
    owl:disjointWith ns2:Opening .

ns2:Fantasy a owl:NamedIndividual ;
    rdfs:label "Fantasy"@en ;
    rdfs:comment "A genre of speculative fiction set in a fictional universe, often inspired by real world myth and folklore."@en .

ns2:Kimi_No_Na_Wa_main a ns2:Main,
        owl:NamedIndividual ;
    rdfs:label "KNNW main"@en ;
    ns2:narrativeRoleIn ns2:Kimi_No_Na_Wa ;
    rdfs:comment "A main role for Kimi No Na Wa."@en .

ns2:Sakamichi_No_Apollon_main a ns2:Main,
        owl:NamedIndividual ;
    rdfs:label "SNA main"@en ;
    ns2:narrativeRoleIn ns2:Sakamichi_No_Apollon ;
    rdfs:comment "A main role in Sakamichi No Apollon"@en .

ns2:ThemeSong a owl:Class ;
    rdfs:label "Theme Song"@en ;
    rdfs:comment "A piece of music from a television programme, film, etc. that is remembered as the music that represents that programme or film."@en .

ns2:roleIn a owl:ObjectProperty ;
    rdfs:label "role In"@en ;
    rdfs:comment "A relation between a role and the programme in which operates."@en ;
    rdfs:domain ns1:Role ;
    rdfs:range <http://purl.org/ontology/po/Programme> .

foaf:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "The Person class represents people. Something is a Person if it is a person. We don't nitpic about whether they're alive, dead, real, or imaginary."@en ;
    rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent> .

<http://purl.org/ontology/po/Series> a owl:Class ;
    rdfs:label "Series"@en ;
    rdfs:comment "A series"@en ;
    rdfs:subClassOf <http://purl.org/ontology/po/Programme>,
        <http://www.ontologydesignpatterns.org/cp/owl/list.owl#List> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf [ ] ] .


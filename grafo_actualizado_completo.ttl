    rdfs:comment "A person that has the role of the sound director."@en ;
    rdfs:subClassOf ns2:RealPerson ;
    owl:equivalentClass [ ] .

ns2:SupportingCharacter a owl:Class ;
    rdfs:label "Supporting Character"@en ;
    rdfs:comment "A character that has a supporting role."@en ;
    rdfs:subClassOf ns2:Character ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf [ ] ] .


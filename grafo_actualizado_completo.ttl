ns2:VoiceActor a owl:Class ;
    rdfs:label "Voice Actor"@en ;
    rdfs:comment "A person that has the role of voice acting."@en ;
    rdfs:subClassOf ns2:RealPerson ;
    owl:equivalentClass [ ] .

ns2:Movie a owl:Class ;
    rdfs:label "movie"@en ;
    rdfs:comment "A film with a running time long enough to be considered the principal or sole film to fill a program."@en ;
    rdfs:subClassOf <http://purl.org/ontology/po/Programme> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf [ ] ] .

ns2:Character a owl:Class ;
    rdfs:label "Character"@en ;
    rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent> ;
    owl:equivalentClass [ ],
        [ a owl:Class ;
            owl:intersectionOf [ ] ] .

ns2:RealPerson a owl:Class ;
    rdfs:label "Real Person"@en ;
    rdfs:comment "A person that exists, or existed, in the real world"@en ;
    rdfs:subClassOf foaf:Person .

onto:AnimeSeries a owl:Class ;
    rdfs:label "Anime Series" ;
    owl:equivalentClass <http://purl.org/ontology/po/Programme> .


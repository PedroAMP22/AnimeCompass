ns1:hasEnding a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has Ending"@en ;
    rdfs:comment "A relation between a programme and its ending theme."@it ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range ns1:Ending .

ns1:isEpisodeOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is episode of"@en ;
    rdfs:comment "A relation between an episode and the series which is part of."@en ;
    rdfs:domain <http://purl.org/ontology/po/Episode> ;
    rdfs:range <http://purl.org/ontology/po/Series> ;
    rdfs:subPropertyOf ns3:itemOf .

ns1:openingOf a owl:ObjectProperty ;
    rdfs:label "opening of"@en ;
    rdfs:comment "A relation between an opening theme and its programme."@en ;
    rdfs:domain ns1:Opening ;
    rdfs:range <http://purl.org/ontology/po/Programme> .

ns1:precedesEpisode a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes episode"@en ;
    rdfs:comment "Relation between an episode and the successive."@en ;
    rdfs:domain <http://purl.org/ontology/po/Episode> ;
    rdfs:range <http://purl.org/ontology/po/Episode> ;
    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> .

ns1:producedBy a owl:ObjectProperty ;
    rdfs:label "produced By"@en ;
    rdfs:comment "A relation between a programme and the studio that produced it."@en ;
    rdfs:domain <http://purl.org/ontology/po/Programme> ;
    rdfs:range ns1:Studio .

ns1:voiceOf a owl:ObjectProperty ;
    rdfs:label "voice of"@en ;
    rdfs:comment "Relation between a voice actor and the character that interprets."@en ;
    rdfs:domain ns1:VoiceActor ;
    rdfs:range ns1:Character ;
    owl:propertyChainAxiom [ ] .


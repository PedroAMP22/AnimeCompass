    ns1:isEpisodeOf ns1:Death_Parade ;
    ns1:runtime 23 ;
    rdfs:comment "An episode of Death Parade."@en .

ns1:Drama a owl:NamedIndividual ;
    rdfs:label "Drama"@en ;
    rdfs:comment "A genre of programme intended to be more serious than humorous in tone."@en .

ns1:Etsuko_Ichihara a owl:NamedIndividual ;
    rdfs:label "Etsuko Ichihara"@jp ;
    ns2:hasRole ns1:voice_actor_Hitoha_Miyazumi ;
    rdfs:comment "A voice actor."@en .

ns1:Fantasy a owl:NamedIndividual ;
    rdfs:label "Fantasy"@en ;
    rdfs:comment "A genre of speculative fiction set in a fictional universe, often inspired by real world myth and folklore."@en .

ns1:ImaginaryPerson a owl:Class ;
    rdfs:label "Imaginary Person"@en ;
    rdfs:comment "A person that doesn't exist in the real world."@en ;
    rdfs:subClassOf foaf:Person .

ns1:Junichi_Suwabe a owl:NamedIndividual ;
    rdfs:label "Junichi Suwabe"@jp ;
    ns2:hasRole ns1:voice_actor_Junichi_Katsuragi ;

    rdfs:comment "A film with a running time long enough to be considered the principal or sole film to fill a program."@en ;
    rdfs:subClassOf <http://purl.org/ontology/po/Programme> .

ns1:Mystery a owl:NamedIndividual ;
    rdfs:label "Mystery"@en ;
    rdfs:comment "A genre of programme that revolves around the solution of a problem or a crime."@en .

ns1:Radwimps a owl:NamedIndividual ;

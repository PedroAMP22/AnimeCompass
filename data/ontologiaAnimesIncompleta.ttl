ns1:VoiceActorRole a owl:Class ;
    rdfs:label "Voice Actor Role"@en ;
    rdfs:comment "A role whose job is to provide the voices for characters in animated films."@en ;
    rdfs:subClassOf ns1:ProductionRole .


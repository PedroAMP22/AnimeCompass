    rdfs:range ns1:Ending .

ns1:isEpisodeOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is episode of"@en ;
    rdfs:comment "A relation between an episode and the series which is part of."@en ;
    rdfs:domain <http://purl.org/ontology/po/Episode> ;
    rdfs:range <http://purl.org/ontology/po/Series> ;
    rdfs:subPropertyOf ns3:itemOf .

ns1:openingOf a owl:ObjectProperty ;
    rdfs:label "opening of"@en ;

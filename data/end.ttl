    rdfs:subClassOf ns1:ProductionRole .

ns1:Main a owl:Class ;
    rdfs:label ":Main"@en ;
    rdfs:comment "A main character"@en ;
    rdfs:subClassOf ns1:NarrativeRole ;
    owl:disjointWith ns1:Supporting,
        ns1:Villain .


onto:AnimeOntology a owl:Ontology ;
    rdfs:label "Ontología de series de animación japonesas (Wikidata)" .

onto:hasGenre a owl:ObjectProperty ;
    rdfs:domain onto:AnimeSeries ;
    rdfs:range onto:Genre .

onto:numEpisodes a owl:DatatypeProperty ;
    rdfs:domain onto:AnimeSeries ;
    rdfs:range xsd:integer .

onto:numSeasons a owl:DatatypeProperty ;
    rdfs:domain onto:AnimeSeries ;
    rdfs:range xsd:integer .

onto:startDate a owl:DatatypeProperty ;
    rdfs:domain onto:AnimeSeries ;
    rdfs:range xsd:year .

